# Copy to .env. Keep credentials out of source control.
FACE_MODEL_PATH=/app/models/source/yolov12n-face.onnx
FACE_WEB_PORT=8080
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=1

# SQLite and camera URL encryption defaults (normally keep these in the persistent data/ volume).
FACE_DATABASE_PATH=/app/data/database/gateway.db
FACE_SECRET_PATH=/app/data/secrets/camera.key
# Optional: provide a Fernet key from a secret manager instead of generating data/secrets/camera.key.
# FACE_SECRET_KEY=
